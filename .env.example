# Modelo de referência: não contém credenciais reais nem configura um ambiente automaticamente.
# Não aponte este arquivo para projetos de teste proibidos e nunca versione segredos.
# Para testes de desenvolvimento, prefira mocks locais. Valores reais só devem ser
# configurados no escopo autorizado do serviço correspondente, nunca no frontend ou no Git.
SUPABASE_URL=https://YOUR_APPROVED_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_SERVER_SECRET_OUTSIDE_SOURCE_CONTROL
CRM_ALLOWED_ORIGIN=https://YOUR_OFFICIAL_NETLIFY_SITE.netlify.app
CRM_LOGIN_PASSWORD=SET_A_LONG_UNIQUE_SECRET_OUTSIDE_SOURCE_CONTROL
CRM_SESSION_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_OUTSIDE_SOURCE_CONTROL

# Integração WhatsApp: manter desativada durante testes simulados.
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_ACCESS_TOKEN=SET_ONLY_IN_APPROVED_SERVER_ENVIRONMENT
WHATSAPP_PHONE_NUMBER_ID=SET_ONLY_IN_APPROVED_SERVER_ENVIRONMENT
WHATSAPP_TEMPLATE_NAME=SET_APPROVED_TEMPLATE_NAME
WHATSAPP_TEMPLATE_LANGUAGE=SET_APPROVED_TEMPLATE_LANGUAGE
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_APP_SECRET=SET_ONLY_IN_APPROVED_SERVER_ENVIRONMENT
WHATSAPP_WEBHOOK_VERIFY_TOKEN=SET_ONLY_IN_APPROVED_SERVER_ENVIRONMENT
AUTOMATIONS_ENABLED=false
