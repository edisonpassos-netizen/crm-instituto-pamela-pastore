# Modelo de configuração. Use somente valores de um ambiente isolado de teste.
# Nunca use credenciais ou banco de produção neste ambiente.
SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_TEST_SERVER_SECRET_IN_NETLIFY_ONLY
CRM_ALLOWED_ORIGIN=https://YOUR-TEST-SITE.netlify.app
CRM_LOGIN_PASSWORD=SET_A_LONG_UNIQUE_TEST_PASSWORD_IN_NETLIFY
CRM_SESSION_SECRET=SET_A_RANDOM_TEST_SECRET_OF_AT_LEAST_32_CHARACTERS_IN_NETLIFY

# Teste isolado da Meta: mantenha false até configurar e validar um número de teste.
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_ACCESS_TOKEN=SET_TEST_TOKEN_IN_ISOLATED_ENVIRONMENT
WHATSAPP_PHONE_NUMBER_ID=SET_META_TEST_PHONE_NUMBER_ID
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_APP_SECRET=SET_TEST_APP_SECRET
WHATSAPP_WEBHOOK_VERIFY_TOKEN=SET_RANDOM_TEST_VERIFY_TOKEN
